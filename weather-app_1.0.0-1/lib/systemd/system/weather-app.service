[Unit]
Description=Weather App Service
After=network.target

[Service]
Type=simple
User=weather-app
Group=weather-app
WorkingDirectory=/var/lib/weather-app
ExecStart=/usr/local/bin/weather-app --config /etc/weather-app/config.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=weather-app
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/weather-app /var/log/weather-app
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
